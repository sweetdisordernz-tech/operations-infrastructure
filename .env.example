# Neon Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session / auth
SESSION_SECRET="replace-with-a-long-random-string"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Shopify webhook signature verification (orders/create, orders/updated).
# Real Shopify credentials aren't set up yet - this is a placeholder so the
# webhook works correctly once they are. To swap in the real one:
#   1. Shopify Admin -> Settings -> Notifications -> Webhooks (or via the
#      Shopify app you create), add a webhook pointing at
#      https://<your-domain>/api/webhooks/shopify for orders/create and
#      orders/updated.
#   2. Shopify shows/generates a signing secret for that webhook (or your
#      app's API secret key, if using an app-scoped webhook) - copy it here
#      and into the same env var on Vercel.
# Until then, `npm run test:webhook` signs requests with this same
# placeholder value so you can exercise the full flow locally.
SHOPIFY_WEBHOOK_SECRET="test-secret-replace-with-real-shopify-signing-secret"

# Brevo (not wired up yet - stage 1 just logs magic link tokens to console)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="orders@sweetdisorder.co.nz"

# Base domain used to derive subdomains in production (portal.*, admin.*, dashboard.*, floor.*)
NEXT_PUBLIC_ROOT_DOMAIN="sweetdisorder.co.nz"
