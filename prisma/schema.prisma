// Sweet Disorder Ops - shared Prisma schema (stage 1 foundation)
// Neon Postgres via the Neon serverless driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER_ADMIN
  EMPLOYEE
}

enum Region {
  NZ
  AU
}

enum PackagingType {
  BOTTLE
  JAR
  TIN
  STAND
}

enum AllergenStatus {
  CORRECT
  NEEDS_CHANGE_URGENT
  NEEDS_CHANGE_NON_URGENT
}

enum AddressStatus {
  CORRECT
  INCORRECT
}

enum CountryOfOriginStatus {
  CORRECT
  INCORRECT
}

enum NutritionBoxStatus {
  CORRECT
  NEEDS_COLUMN_ADDED
  INCORRECT
}

enum LabelUrgency {
  TOP_PRIORITY_URGENT
  URGENT_CHANGE_NEEDED
  CHANGE_NEEDED_NOT_URGENT
  NO_CHANGE_NEEDED
}

enum OrderSource {
  SHOPIFY
  WHOLESALE_PORTAL
}

enum OrderStatus {
  PENDING
  LABELLING
  PACKING
  DISPATCHED
}

enum PaymentPhase {
  INVOICE
  PORTAL_PAYMENT
}

enum PaymentStatus {
  AWAITING_INVOICE
  PAID
}

enum OrderTaskStage {
  LABELLING
  PACKING
  DISPATCH
}

enum OrderTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum OrderTaskLineItemStatus {
  PENDING
  DONE
}

enum SalesLeadStage {
  SOURCE
  QUALIFY
  OUTREACH_SENT
  NURTURE
  PROPOSAL_SAMPLE_SENT
  CLOSED_WON
  CLOSED_LOST
  RETAIN_REFERRAL
}

enum LeadSegment {
  HR_WELLBEING_CULTURE
  EVENT_MARKETING_AGENCY
  SALES_TEAM_CLIENT_GIFTING
  OTHER
}

enum EmailTemplateCategory {
  EDM_SEQUENCE
  COLD_OUTREACH
  RESPONSE_SCENARIO
}

enum IntegrationName {
  SHOPIFY
  XERO
  KLAVIYO
  BREVO
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationSyncStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole
  pinHash   String?  @map("pin_hash")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  magicLinkTokens     MagicLinkToken[]
  assignedOrderTasks  OrderTask[]          @relation("OrderTaskAssignedEmployee")
  labourLogs          EmployeeLabourLog[]
  ownedSalesLeads     SalesLead[]          @relation("SalesLeadOwner")
  stockAdjustmentLogs StockAdjustmentLog[]

  @@map("users")
}

model WholesaleCustomer {
  id                String   @id @default(cuid())
  companyName       String   @map("company_name")
  contactName       String   @map("contact_name")
  email             String   @unique
  phone             String?
  region            Region
  /**
   * Whether this customer is allowed to split a single order's line items
   * across both NZ and AU destinations in the wholesale portal cart.
   * Defaults false: an order goes entirely to `region` unless a staff
   * member has explicitly flagged this account as shipping to both.
   */
  shipsToBothRegions Boolean @default(false) @map("ships_to_both_regions")
  pricingTierId     String?  @map("pricing_tier_id")
  shopifyCustomerId String?  @unique @map("shopify_customer_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  pricingTier      PricingTier?     @relation(fields: [pricingTierId], references: [id])
  orders           Order[]
  magicLinkTokens  MagicLinkToken[]

  @@index([pricingTierId])
  @@map("wholesale_customers")
}

model PricingTier {
  id        String   @id @default(cuid())
  name      String
  region    Region
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wholesaleCustomers WholesaleCustomer[]
  products           PricingTierProduct[]

  @@map("pricing_tiers")
}

/**
 * Explicit per-SKU price override for a pricing tier - a real relation, not
 * a JSON blob, matching how the rest of the schema favors relations (e.g.
 * Filling) over loosely-typed data. A product with no row here for a given
 * tier has no wholesale price set yet; the portal treats that as
 * "not orderable yet" rather than guessing or falling back to a retail
 * price that doesn't exist anywhere in this schema.
 */
model PricingTierProduct {
  id            String   @id @default(cuid())
  pricingTierId String   @map("pricing_tier_id")
  productId     String   @map("product_id")
  price         Decimal
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pricingTier PricingTier @relation(fields: [pricingTierId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([pricingTierId, productId])
  @@index([productId])
  @@map("pricing_tier_products")
}

model MagicLinkToken {
  id                  String    @id @default(cuid())
  email               String
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  userId              String?   @map("user_id")
  wholesaleCustomerId String?   @map("wholesale_customer_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user              User?              @relation(fields: [userId], references: [id])
  wholesaleCustomer WholesaleCustomer? @relation(fields: [wholesaleCustomerId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([wholesaleCustomerId])
  @@map("magic_link_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ProductRange {
  id        String   @id @default(cuid())
  name      String
  skuPrefix String   @map("sku_prefix")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_ranges")
}

model Filling {
  id                String   @id @default(cuid())
  name              String   @unique
  supplierId        String?  @map("supplier_id")
  unitOfPurchase    String?  @map("unit_of_purchase")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  supplier  Supplier?         @relation(fields: [supplierId], references: [id])
  products  Product[]
  inventory FillingInventory?

  @@index([supplierId])
  @@map("fillings")
}

model FillingInventory {
  id                       String    @id @default(cuid())
  fillingId                String    @unique @map("filling_id")
  quantityOnHand           Decimal   @default(0) @map("quantity_on_hand")
  portionsPerPurchaseUnit  Decimal?  @map("portions_per_purchase_unit")
  reorderThreshold         Decimal?  @map("reorder_threshold")
  lastCountedAt            DateTime? @map("last_counted_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  filling Filling @relation(fields: [fillingId], references: [id])

  @@map("filling_inventory")
}

model Product {
  id               String        @id @default(cuid())
  sku              String?       @unique
  barcode          String?
  name             String
  rangeId          String        @map("range_id")
  packagingType    PackagingType @map("packaging_type")
  fillingId        String?       @map("filling_id")
  minOrderQty      Int           @default(1) @map("min_order_qty")
  imageBlobUrl     String?       @map("image_blob_url")
  active           Boolean       @default(true)
  discontinued     Boolean       @default(false)
  wholesaleVisible Boolean       @default(false) @map("wholesale_visible")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  range                   ProductRange           @relation(fields: [rangeId], references: [id])
  filling                 Filling?               @relation(fields: [fillingId], references: [id])
  inventoryItem           InventoryItem?
  labelComplianceRecords  LabelComplianceRecord[]
  orderLineItems          OrderLineItem[]
  pricingTierProducts     PricingTierProduct[]

  @@index([rangeId])
  @@index([fillingId])
  @@map("products")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactEmail  String?  @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  leadTimeDays  Int?     @map("lead_time_days")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fillings       Filling[]
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryItem {
  id                    String    @id @default(cuid())
  productId             String    @unique @map("product_id")
  quantityOnHand        Int       @default(0) @map("quantity_on_hand")
  reorderThreshold      Int?      @map("reorder_threshold")
  recommendedReorderQty Int?      @map("recommended_reorder_qty")
  supplierId            String?   @map("supplier_id")
  lastCountedAt         DateTime? @map("last_counted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  product     Product              @relation(fields: [productId], references: [id])
  supplier    Supplier?            @relation(fields: [supplierId], references: [id])
  adjustments StockAdjustmentLog[]

  @@index([supplierId])
  @@map("inventory_items")
}

/**
 * Audit trail for manual InventoryItem.quantityOnHand changes made from
 * Master Connect (Section 9's "manual stock adjustment with audit trail").
 * Order-driven decrements aren't logged here - only staff-initiated
 * corrections, which is what "who changed this and when" is actually asking.
 */
model StockAdjustmentLog {
  id               String   @id @default(cuid())
  inventoryItemId  String   @map("inventory_item_id")
  changedByUserId  String   @map("changed_by_user_id")
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  changedByUser User          @relation(fields: [changedByUserId], references: [id])

  @@index([inventoryItemId])
  @@index([changedByUserId])
  @@map("stock_adjustment_logs")
}

// ---------------------------------------------------------------------------
// Label compliance
// ---------------------------------------------------------------------------

model LabelComplianceRecord {
  id                        String                 @id @default(cuid())
  productId                 String                 @map("product_id")
  allergenStatus            AllergenStatus         @map("allergen_status")
  allergenNotes              String?               @map("allergen_notes")
  addressStatus             AddressStatus          @map("address_status")
  countryOfOriginStatus     CountryOfOriginStatus  @map("country_of_origin_status")
  nutritionBoxStatus        NutritionBoxStatus     @map("nutrition_box_status")
  labelsInStock             Int?                   @map("labels_in_stock")
  urgency                   LabelUrgency
  lastReviewedAt            DateTime?              @map("last_reviewed_at")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([urgency])
  @@map("label_compliance_records")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique @map("order_number")
  source              OrderSource
  wholesaleCustomerId String?       @map("wholesale_customer_id")
  shopifyOrderId      String?       @unique @map("shopify_order_id")
  region              Region
  status              OrderStatus   @default(PENDING)
  paymentPhase        PaymentPhase  @map("payment_phase")
  paymentStatus       PaymentStatus @map("payment_status")
  totalAmount         Decimal       @map("total_amount")
  currency            String
  placedAt            DateTime      @map("placed_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  wholesaleCustomer WholesaleCustomer? @relation(fields: [wholesaleCustomerId], references: [id])
  lineItems         OrderLineItem[]
  tasks             OrderTask[]

  @@index([wholesaleCustomerId])
  @@index([status])
  @@map("orders")
}

model OrderLineItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  taskLineItem OrderTaskLineItem?

  @@index([orderId])
  @@index([productId])
  @@map("order_line_items")
}

model OrderTask {
  id                  String          @id @default(cuid())
  orderId             String          @map("order_id")
  stage               OrderTaskStage
  status              OrderTaskStatus @default(PENDING)
  assignedEmployeeId  String?         @map("assigned_employee_id")
  startedAt           DateTime?       @map("started_at")
  completedAt         DateTime?       @map("completed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  order            Order               @relation(fields: [orderId], references: [id])
  assignedEmployee User?               @relation("OrderTaskAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  labourLogs       EmployeeLabourLog[]
  lineItems        OrderTaskLineItem[]

  @@index([orderId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@map("order_tasks")
}

/**
 * One row per OrderLineItem, but only ever created for a LABELLING-stage
 * OrderTask. Lets labelling be reorganized and batched by product across
 * every pending order (the floor app's main screen), while still being
 * able to tell, per order, when every one of its line items is done - which
 * is what flips the parent LABELLING OrderTask to DONE and makes PACKING
 * claimable for that order. PACKING and DISPATCH stay strictly per-order
 * and don't get rows here.
 */
model OrderTaskLineItem {
  id              String                   @id @default(cuid())
  orderTaskId     String                   @map("order_task_id")
  orderLineItemId String                   @unique @map("order_line_item_id")
  status          OrderTaskLineItemStatus  @default(PENDING)
  completedAt     DateTime?                @map("completed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  orderTask     OrderTask     @relation(fields: [orderTaskId], references: [id])
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id])

  @@index([orderTaskId])
  @@index([status])
  @@map("order_task_line_items")
}

// ---------------------------------------------------------------------------
// Labour / sales / integrations
// ---------------------------------------------------------------------------

model EmployeeLabourLog {
  id           String   @id @default(cuid())
  employeeId   String   @map("employee_id")
  date         DateTime
  hoursWorked  Decimal  @map("hours_worked")
  orderTaskId  String?  @map("order_task_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee  User       @relation(fields: [employeeId], references: [id])
  orderTask OrderTask? @relation(fields: [orderTaskId], references: [id])

  @@index([employeeId])
  @@index([orderTaskId])
  @@index([date])
  @@map("employee_labour_logs")
}

/**
 * The corporate-gifting pipeline (brief Section 5.3/10.6). Schema matches
 * the business's real lead tracker: an 8-stage pipeline (not a generic
 * 5-stage CRM guess), a fixed segment enum, and last_touch_date tracked
 * separately from updatedAt so editing a note doesn't count as a "touch".
 */
model SalesLead {
  id               String         @id @default(cuid())
  leadNumber       Int            @unique @default(autoincrement()) @map("lead_number")
  companyName      String         @map("company_name")
  contactName      String?        @map("contact_name")
  email            String?
  phone            String?
  segment          LeadSegment
  stage            SalesLeadStage @default(SOURCE)
  source           String?
  nextActionDate   DateTime?      @map("next_action_date")
  nextAction       String?        @map("next_action")
  estOrderValueNzd Decimal?       @map("est_order_value_nzd")
  notes            String?
  lastTouchDate    DateTime?      @map("last_touch_date")
  ownerUserId      String         @map("owner_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  ownerUser User @relation("SalesLeadOwner", fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
  @@index([email])
  @@index([stage])
  @@index([segment])
  @@index([nextActionDate])
  @@map("sales_leads")
}

/**
 * Send-ready corporate outreach copy (brief Section 5.3/10.6) - a
 * read-only reference library Molly copies from, not something this
 * platform sends. EDM rows are numbered 1-5 via sequencePosition;
 * response-scenario rows use scenarioName instead; segment is null for
 * copy written for a mixed list (e.g. the EDM sequence) rather than one
 * specific segment.
 */
model EmailTemplate {
  id               String                 @id @default(cuid())
  category         EmailTemplateCategory
  sequencePosition Int?                   @map("sequence_position")
  segment          LeadSegment?
  scenarioName     String?                @map("scenario_name")
  sendTimingNotes  String?                @map("send_timing_notes")
  subject          String
  subjectAltHr     String?                @map("subject_alt_hr")
  subjectAltAgency String?                @map("subject_alt_agency")
  subjectAltSales  String?                @map("subject_alt_sales")
  preheader        String?
  body             String
  ctaLabel         String?                @map("cta_label")
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([category])
  @@index([segment])
  @@map("email_templates")
}

/**
 * The seasonal outreach calendar (brief Section 5.3/10.6), sourced from
 * the business's real "NZ Gifting Calendar". Dates are deliberately
 * free text (approxTiming/triggerBy) since several shift yearly - never
 * force these into rigid calendar dates. isAlwaysOn marks the one
 * standing/non-seasonal row (Work Anniversaries).
 */
model GiftingOccasion {
  id           String   @id @default(cuid())
  occasionName String   @map("occasion_name")
  approxTiming String   @map("approx_timing")
  triggerBy    String   @map("trigger_by")
  notes        String?
  isAlwaysOn   Boolean  @default(false) @map("is_always_on")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gifting_occasions")
}

/**
 * The business's static corporate one-pager (brief Section 10.6) -
 * hosted in Vercel Blob and linked from the Sales & Marketing dashboard.
 * A single well-known row (id "singleton"), not a general asset library.
 */
model CorporateOnePager {
  id        String   @id @default("singleton")
  blobUrl   String?  @map("blob_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("corporate_one_pager")
}

model IntegrationSyncLog {
  id             String                @id @default(cuid())
  integration    IntegrationName
  direction      IntegrationDirection
  status         IntegrationSyncStatus
  payloadSummary String?               @map("payload_summary")
  errorMessage   String?               @map("error_message")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([integration])
  @@index([status])
  @@map("integration_sync_logs")
}
